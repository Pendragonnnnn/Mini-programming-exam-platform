# Copy this file to .env and change every secret before deploying.

# --- core
NODE_ENV=production
APP_PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://aegis:change-me@db:5432/aegis
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# --- code runner
# local  = runs code with java/python inside the API container. NOT a sandbox — dev/demo only.
# judge0 = runs code in Judge0's isolated runner (required in production).
RUNNER=judge0
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=
RUN_MAX_CONCURRENCY=4

# --- Safe Exam Browser (your team's SEB config). Keys come from SEB Config Tool.
SEB_REQUIRED=false
SEB_CONFIG_KEY=
SEB_BROWSER_EXAM_KEYS=

# --- AI grading assistant: heuristic (free, no model) | ollama | none
AI_PROVIDER=heuristic
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen2.5-coder:7b

# --- email (optional). Without SMTP_HOST the app still works: teachers copy each student's
#     sign-in link from the Students page and send it themselves.
APP_NAME=Aegis Exam
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INVITE_TTL_DAYS=14

AUDIT_RETENTION_DAYS=730
