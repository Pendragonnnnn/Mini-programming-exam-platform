# For local development (npm run dev). Copy to api/.env if you need to change anything.
DATABASE_URL=postgres://aegis:aegis@127.0.0.1:5432/aegis
APP_PUBLIC_URL=http://localhost:5173
RUNNER=local
AI_PROVIDER=heuristic
SEB_REQUIRED=false
# Email is optional. Without it, copy students' sign-in links from the Students page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Demo testing mode (local development ONLY) ---------------------------------------------
# Adds "Demo Student" / "Demo Teacher" buttons on the login page and the accounts
# demo_student / DemoStudent123 and demo_teacher / DemoTeacher123 (they only see the course DEMO101).
# Works only when BOTH lines are set. It is always off when NODE_ENV=production (e.g. docker compose).
# To turn it off: delete these two lines (or set DEMO_MODE=false) and restart the API.
# DEMO_MODE=true
# NODE_ENV=development
z