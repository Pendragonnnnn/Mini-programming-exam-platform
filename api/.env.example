# For local development (npm run dev). Copy to api/.env if you need to change anything.
DATABASE_URL=postgres://aegis:aegis@127.0.0.1:5432/aegis
APP_PUBLIC_URL=http://localhost:5173
RUNNER=local
AI_PROVIDER=heuristic
SEB_REQUIRED=false
# Email is optional. Without it, copy students' sign-in links from the Students page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=